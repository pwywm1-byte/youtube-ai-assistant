# YouTube AI Assistant - Environment Configuration\n\n# ============================================================================\n# API Configuration\n# ============================================================================\nAPI_HOST=0.0.0.0\nAPI_PORT=8000\nAPI_DEBUG=false\nAPI_WORKERS=4\nSECRET_KEY=your-secret-key-change-in-production\n\n# ============================================================================\n# Database Configuration\n# ============================================================================\nDATABASE_URL=postgresql://user:password@localhost:5432/youtube_ai\nDATABASE_ECHO=false\nDATABASE_POOL_SIZE=20\n\n# ============================================================================\n# Redis Configuration (for task queue)\n# ============================================================================\nREDIS_URL=redis://localhost:6379/0\n\n# ============================================================================\n# YouTube API Configuration\n# ============================================================================\n# Get these from: https://console.cloud.google.com/\nYOUTUBE_CLIENT_ID=your_client_id_here\nYOUTUBE_CLIENT_SECRET=your_client_secret_here\nYOUTUBE_CHANNEL_ID=@your_channel_handle_or_id\nYOUTUBE_REFRESH_TOKEN=your_refresh_token_here\n\n# ============================================================================\n# OpenAI API Configuration\n# ============================================================================\n# Get from: https://platform.openai.com/account/api-keys\nOPENAI_API_KEY=sk-your_openai_key_here\nOPENAI_MODEL=gpt-4\nOPENAI_TEMPERATURE=0.7\n\n# ============================================================================\n# Anthropic API Configuration (Optional)\n# ============================================================================\nANTHROPIC_API_KEY=your_anthropic_key_here\n\n# ============================================================================\n# ElevenLabs Text-to-Speech Configuration\n# ============================================================================\n# Get from: https://elevenlabs.io/\nELEVENLABS_API_KEY=your_elevenlabs_key_here\nELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM\n\n# ============================================================================\n# Stock Image/Video APIs\n# ============================================================================\n# Unsplash: https://unsplash.com/developers\nUNSPLASH_ACCESS_KEY=your_unsplash_key_here\n\n# Pexels: https://www.pexels.com/api/\nPEXELS_API_KEY=your_pexels_key_here\n\n# ============================================================================\n# Video Output Configuration\n# ============================================================================\nVIDEO_QUALITY=1080p\nVIDEO_BITRATE=8000k\nAUDIO_BITRATE=192k\nSUBTITLE_LANGUAGE=en\n\n# Video duration settings (in seconds)\nSHORT_DURATION_MIN=30\nSHORT_DURATION_MAX=60\nLONG_FORM_DURATION_MIN=900\nLONG_FORM_DURATION_MAX=1500\n\n# ============================================================================\n# Publishing Configuration\n# ============================================================================\nPUBLISH_SHORT_TIME=09:00\nPUBLISH_LONGFORM_TIME=18:00\nPUBLISH_TIMEZONE=America/New_York\n\n# ============================================================================\n# Trend Research Configuration\n# ============================================================================\nTREND_RESEARCH_SOURCES=youtube,google,reddit,news\nTREND_RESEARCH_INTERVAL=daily\nTREND_MIN_SCORE=60\n\n# ============================================================================\n# Logging Configuration\n# ============================================================================\nLOG_LEVEL=INFO\nLOG_FORMAT=json\nLOG_FILE_PATH=./logs\n\n# ============================================================================\n# Development Configuration\n# ============================================================================\nDEVELOPMENT_MODE=false\nDEBUG_VERBOSE=false\n\n# ============================================================================\n# Error Tracking (Sentry)\n# ============================================================================\nSENTRY_DSN=\nSENTRY_ENVIRONMENT=production\n\n# ============================================================================\n# Feature Flags\n# ============================================================================\nENABLE_AUTO_PUBLISH=true\nENABLE_ANALYTICS_TRACKING=true\nENABLE_AUTO_OPTIMIZATION=true\nENABLE_FACT_CHECKING=true\nENABLE_QUALITY_CONTROL=true\n