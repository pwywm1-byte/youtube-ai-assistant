# ============================================
# YOUTUBE API CONFIGURATION
# ============================================
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_CHANNEL_ID=@your_channel_handle_or_id
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# ============================================
# AI SERVICES CONFIGURATION
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=default_voice_id

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/youtube_ai_assistant
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ============================================
# STORAGE CONFIGURATION
# ============================================
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage/videos

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=youtube-ai-videos

# ============================================
# CONTENT GENERATION SETTINGS
# ============================================
VIDEO_QUALITY=1080p
VIDEO_BITRATE=8000k
AUDIO_BITRATE=192k
SUBTITLE_LANGUAGE=en

SHORT_DURATION_MIN=30
SHORT_DURATION_MAX=60
LONG_FORM_DURATION_MIN=900
LONG_FORM_DURATION_MAX=1500

# ============================================
# PUBLISHING SCHEDULE
# ============================================
PUBLISH_SHORT_TIME=09:00
PUBLISH_LONGFORM_TIME=18:00
PUBLISH_TIMEZONE=America/New_York

# ============================================
# TREND RESEARCH SETTINGS
# ============================================
TREND_RESEARCH_SOURCES=youtube,google,reddit,news
TREND_RESEARCH_INTERVAL=daily
TREND_MIN_SCORE=60

# ============================================
# API SERVER CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_WORKERS=4

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs

# ============================================
# SENTRY CONFIGURATION
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-secret-key-change-this
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_AUTO_PUBLISH=True
ENABLE_ANALYTICS_TRACKING=True
ENABLE_AUTO_OPTIMIZATION=True
ENABLE_FACT_CHECKING=True
ENABLE_QUALITY_CONTROL=True

# ============================================
# DEVELOPMENT
# ============================================
DEVELOPMENT_MODE=False
DEBUG_VERBOSE=False
